set hidden true    # show dotfiles (toggle with zh)

# Open the file in the pane to the left: ":e" if vim is running there,
# otherwise start vim on the file (e.g. after vim was quit and left a shell).
cmd open-in-vim &{{
    pane=$(tmux list-panes -t "$TMUX_PANE" -F '#{pane_id}' | grep -v "$TMUX_PANE" | head -1)
    cmd=$(tmux display-message -p -t "$pane" '#{pane_current_command}')
    quoted=$(printf '%q' "$f")
    case "$cmd" in
        vim|nvim|vi|view)
            tmux send-keys -t "$pane" Escape
            tmux send-keys -t "$pane" -l ":e $quoted"
            tmux send-keys -t "$pane" Enter ;;
        *)
            tmux send-keys -t "$pane" -l "vim $quoted"
            tmux send-keys -t "$pane" Enter ;;
    esac
}}

map <enter> open-in-vim
